<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.sourceforge.io/dtds/configuration_1_3.dtd">
<module name="Checker">
    <!-- suppressions.xml 적용 -->
    <module name="SuppressionFilter">
        <property name="file" value="${checkstyle.suppressions.file}"/>
    </module>

    <!-- 파일 전역 규칙 -->
    <module name="FileTabCharacter"/>
    <module name="NewlineAtEndOfFile"/>

    <!-- 라인 길이: import/package 라인은 예외 -->
    <module name="LineLength">
        <property name="max" value="140"/>
        <property name="ignorePattern" value="^package|^import"/>
    </module>

    <!-- 소스 트리 규칙 -->
    <module name="TreeWalker">
        <!-- import 관련 -->
        <module name="UnusedImports"/>
        <!-- import 순서와 묶음은 Spotless(Google Java Format)가 정하고 spotlessCheck가 검사한다.
             Google Java Format은 import를 한 묶음으로 정렬하므로 여기서 다시 검사하면 항상 충돌한다. -->

        <!-- 공백/브레이스 기본. Google Java Format이 만드는 빈 본문 {}는 허용 -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
        </module>
        <module name="NoWhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="NeedBraces"/>

        <!-- 빈 catch는 허용 변수명만 예외 -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="ignored|ignore"/>
        </module>
    </module>
</module>
